# Все публичные значения имеют рабочие дефолты в src/config.public.ts —
# без этого файла проект собирается и работает. Здесь только переопределения.
#
# Секреты (DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN, SUPABASE_JWT_SECRET)
# сюда не кладутся никогда: они живут в Supabase Edge Functions,
# supabase secrets set ...

# Application ID из Discord Developer Portal.
# VITE_DISCORD_CLIENT_ID=   # переопределение, дефолт в src/config.public.ts

# Переопределения публичных значений, если понадобится сменить проект/ключ.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_MAP_ID=

# Только для локальной разработки вне Discord: разрешить редактирование.
VITE_DEV_CAN_EDIT=true
